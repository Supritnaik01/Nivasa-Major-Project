  <script>
    const filterButtons = document.querySelectorAll('.filter');
    const clearAllBtn=document.querySelector('.clearAllBtn');
let selectedFilters = [];

function restoreFilters() {
  const params = new URLSearchParams(window.location.search);
  const categoriesParam = params.get('categories');
  
  if (categoriesParam) {
    selectedFilters = categoriesParam.split(',');
    
    // Mark buttons as active
    filterButtons.forEach(button => {
      const category = button.querySelector('p').textContent;
      if (selectedFilters.includes(category)) {
        button.classList.add('active');
      }
    });
  }
}

// Call on load
restoreFilters();
//clear All
clearAllBtn.addEventListener('click',()=>{
   selectedFilters = [];
   const url = '/listings';
    
    window.location.href = url;
})

const filter=filterButtons.forEach(button => {
  button.addEventListener('click', function() {
    const category = this.querySelector('p').textContent;
    
    // Toggle selection
    if (selectedFilters.includes(category)) {
      selectedFilters = selectedFilters.filter(c => c !== category);
      this.classList.remove('active');
    } else {
      selectedFilters.push(category);
      this.classList.add('active');
    }
    const queryString = selectedFilters.join(',');
    const url = selectedFilters.length > 0 
      ? `/listings?categories=${queryString}` 
      : '/listings';
    
    window.location.href = url;
  });
});

  </script>