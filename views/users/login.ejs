<% layout("/layouts/boilerplate.ejs")%>
<body>
    <div class="row mt-3 form-main-container" >
        <div class="col-md-6 offset-md-3 form-wrapper">
            <h3 class="signup-heading">Login</h3>
    <form action="/login" method="post" class="needs-validation" novalidate>
        <div class="mb-3">
            <label for="username" class="form-label">Username</label>
            <input placeholder="Enter Your Username" name="username" type="text" class="form-control" id="username" required>
        </div>
        
        <div class="mb-3 ">
            <label for="password" class="form-label">Password</label>
            <input placeholder="password" name="password" type="password" id="password" class="form-control" required>
        </div>
       
        <div class="center-btn"><button class="btn  listing-btns ">Login</button></div>
    </form>
    </div></div>
</body>

<script src="/js/form-validator.js"></script>