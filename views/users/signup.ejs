<% layout("/layouts/boilerplate.ejs")%>
<body>
    <div class="row mt-3 form-main-container">
        <div class="col-md-6 offset-md-3 form-wrapper">
            <h3 class="signup-heading">Create a new account</h3>
    <form action="/signup" method="post" class="needs-validation" novalidate>
        <div class="mb-3">
            <label for="username" class="form-label">Username</label>
            <input placeholder="Enter Your Username" name="user[username]" type="text" class="form-control" id="username" required>
            <div class="invalid-feedback">
            *Please enter a valid username
            </div>
        </div>
        <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <input name="user[email]" placeholder="Enter Your Email" id="email" class="form-control" required>
            <div class="invalid-feedback">
            *Please enter a valid email
            </div>
        </div>
        
        <div class="mb-3 ">
            <label for="price" class="form-label">Password</label>
            <input placeholder="password" name="user[password]" type="password" id="password" class="form-control" required>
            <div class="invalid-feedback">
              *Please enter a valid password
        </div></div>
        
        
       
        <div class="center-btn"><button class="btn  listing-btns ">Sign Up</button></div>
    </form>
    </div></div>
</body>

<script src="/js/form-validator.js"></script>