<% layout("/layouts/boilerplate.ejs")%>
<script>
  const lat=<%=listing.coordinates.lat%>
  const lon=<%=listing.coordinates.lon%>
</script>
<body>
    <div class="row offset-xl-2 offset-lg-1">    
    <div class="col-xl-9 col-lg-10">
       <h2 style="color: #1A2E2F;"><%=listing.title%></h2>
       <div class="card show-card" >
      <img src="<%=listing.image.url%>" class="card-img-top show-image" alt="listing image">
      </div></div>
      <div class="col-xl-9 col-lg-10">
      <div class="card-body">
      <p class="card-text">
       <p class="mb-0" style="font-weight: 600;"> <%=listing.description%> </p> 
       <p> &#8377; <%=listing.price.toLocaleString("en-IN")%> <br>
       <%=listing.location%>, <%=listing.country%> <br></p>
        </p>
      </div>
      
    <%  if(currUser && currUser._id.equals(listing.owner._id)) {%>
  <div class=" mb-3 mt-3">
<!-- class="col-sm-3" class="row mb-3 mt-3" -->
<div class="ms-1" style="display: inline-block;"><a href="/listings/<%=listing._id%>/edit" class="btn btn-dark listing-btns ">Edit</a></div>
 <div class="ms-3" style="display: inline-block;">
            <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
            <button class="btn btn-dark ">Delete</button>
            </form>
 </div>
</div>
<%}%>
 </div>
 <!-- </div> -->
    <div class="col-xl-9 col-lg-10">
      <hr>
       <i class="fa-solid fa-user" style="font-size: 1.25rem;"></i> <b>Hosted by <%=listing.owner.username%></b>
      <hr>
    </div>

  
 <!-- BOOKING -->
<%  if(currUser && !currUser._id.equals(listing.owner._id)) {%>
  <div class="col-xl-9 col-lg-10 mt-3">
        <!-- <div class="row offset-xl-2 offset-lg-1">     -->
            <!-- <div class="col-xl-9 col-lg-10"> -->
              
               <div class="card p-3 shadow border-0" style=" width: 100%; border-radius: 12px; background-color: #FAFAF8;">
                  <h5 class="mb-2 fw-semibold">Book this place</h5>
                  <p class=" text-muted">&#8377;<%= listing.price.toLocaleString("en-IN") %> <span class="fs-6">/ night</span></p>

                  <form action="/listings/<%= listing._id %>/bookings" method="POST" novalidate class="needs-validation">
                    <div class="row g-2 ">
                      <div class="col-6 col-md-4">
                        <label for="checkIn" class="form-label small mb-1">Check-in</label>
                        <input type="date" class="form-control form-control-sm" id="checkIn" name="booking[checkIn]"  required>
                        <div class="invalid-feedback">
                        *Please select Valid Check-in date
                        </div>
                      </div>
                      <div class="col-6 col-md-4 ">
                        <label for="checkOut" class="form-label small mb-1">Check-out</label>
                        <input type="date" class="form-control form-control-sm" id="checkOut" name="booking[checkOut]" required disabled>
                        <div class="invalid-feedback">
                        *Please select Valid Check-out date
                        </div>
                      </div>
                   
                    <div class="  col-md-4 " >
                      <label class="form-label small mb-1 invisible">Reserve</label>
                    <button type="submit" class="btn btn-primary w-100 fw-medium" style="height: 50px;" >Reserve</button>
                    </div>
                     </div>
                  </form>
                  <!-- style="position: relative; top: 26px;" -->
              </div>
            <!-- </div> -->
          <!-- </div> -->
  </div>
     <%} %>





  <!-- MAP -->
    <div class="col-xl-9 col-lg-10 mt-3">
      <br>
      <h2>Where you’ll be</h2>
        <div id="map"></div>
    </div>


<!-- review listing -->
    <div class="col-xl-9 col-lg-10 mt-3 " >
      <br><hr>
        <!-- class rating-container -->
       <form action="/listings/<%= listing._id %>/review" method="post" novalidate class="needs-validation">

        <h3 class="rating-label">Rate this property</h3>
  
        <div class="rating-stars ">
            
  <input class="form-check-input" type="checkbox" id="1star" value="1" name="review[rating]">
  <label for="1star" class="star">★</label>
  
  <input class="form-check-input" type="checkbox" id="2star" value="2" name="review[rating]">
  <label for="2star" class="star">★</label>
  
  <input class="form-check-input" type="checkbox" id="3star" value="3" name="review[rating]">
  <label for="3star" class="star">★</label>
  
  <input class="form-check-input" type="checkbox" id="4star" value="4" name="review[rating]">
  <label for="4star" class="star">★</label>
  
  <input class="form-check-input " type="checkbox" id="5star" value="5" name="review[rating]" >
  <label for="5star" class="star">★</label>
</div>

     <div class="mb-3">
            <!-- <label for="description" class="form-label">description</label> -->
            <textarea  placeholder="Share your experience..." maxlength="500" name="review[comment]" rows="9" class="form-control review-text" required></textarea>
 <div class="invalid-feedback">
      Please leave a valid comment.
    </div></div>

<button type="submit" class="rating-btn" disabled>Submit</button>
       </form>
    </div>

<!-- show reviews -->
    <div class="col-xl-9 col-lg-10 my-3">
  <%if(listing.reviews.length){%>
<h4>All reviews</h4>
<div class="row ">
<%for(review of listing.reviews){%>
   <!-- <h6><%=review%></h6> -->
  <div class="col-md-6 my-2 ">
    
     <div class="review-card card">
         
          <!-- Star Rating Display -->
          <div class="review-header card-body">
            <h5 class="card-title"><i class="fa-regular fa-user"></i> <%=review.author.username%></h5>
            <div class="review-stars">
              <% for (let i = 1; i <= 5; i++) { %>
                <span class="review-star <%= i <= review.rating ? 'filled' : 'empty' %>">★</span>
              <% } %>
              <span class="review-rating"><%= review.rating %>/5</span>
            </div>
          
          
          <!-- Review Comment -->
          <p class="review-comment card-text mb-2"><%= review.comment %></p>
          <%  if(currUser && currUser._id.equals(review.author._id)) {%>
          <form action="/listings/<%=listing._id%>/review/<%=review._id%>?_method=delete" method="post">
          <button class="btn btn-dark">delete</button>
          </form>
          <%}%>
        </div> </div>

</div>

<%}%></div>
  <%}%>
  
  </div>
  
  </div>
 <script src="/js/form-validator.js"></script>
 <script src="/js/rating.js"></script>
 <script src="/js/map.js"></script>
</body>
